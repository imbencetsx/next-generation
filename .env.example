# Copy to .env.local for development. `bunx convex dev` fills in the first three automatically.

# Convex deployment used by `bunx convex dev` (dev only).
CONVEX_DEPLOYMENT=
# Convex URLs. NEXT_PUBLIC_* values are baked into the Next.js bundle at build time.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Production builds (CI / build machine only, never commit the value):
# a production deploy key from the Convex dashboard → Settings → Deploy keys.
# `bun run build:prod` then deploys convex/ and builds Next.js against production.
# CONVEX_DEPLOY_KEY=

# Auth secrets live on the Convex deployment, not here. Set them with:
#   bun run auth:setup -- --site-url http://localhost:3000          (dev)
#   bun run auth:setup -- --prod --site-url https://your-domain     (production)
# which sets JWT_PRIVATE_KEY, JWKS and SITE_URL.
